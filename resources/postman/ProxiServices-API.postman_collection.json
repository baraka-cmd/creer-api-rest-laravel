{
  "info": {
    "name": "ProxiServices API — Guide de test",
    "description": "Collection de travail sans secrets. Vérifier routes et réponses sur le backend réel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "service_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Catégories actives",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/categories"
          }
        },
        {
          "name": "Recherche de services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/services?category_id={{category_id}}&page=1&per_page=15"
          }
        },
        {
          "name": "Détail service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/services/{{service_id}}"
          }
        }
      ]
    },
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Inscription de test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Compte de démonstration\",\n  \"email\": \"demo.professional@example.test\",\n  \"password\": \"ChangeMe-Local-Only-123!\",\n  \"password_confirmation\": \"ChangeMe-Local-Only-123!\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Connexion — récupérer token (ajuster le champ à la réponse réelle)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.professional@example.test\",\n  \"password\": \"ChangeMe-Local-Only-123!\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Profil courant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/me"
          }
        },
        {
          "name": "Déconnexion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Gestion professionnelle (authentifié)",
      "item": [
        {
          "name": "Créer service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Assistance réseau — test local\",\n  \"description\": \"Donnée de démonstration à supprimer après test.\",\n  \"category_id\": 1,\n  \"price\": 25\n}"
            },
            "url": "{{base_url}}/api/v1/professional/services"
          }
        },
        {
          "name": "Modifier service propriétaire",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Assistance réseau — modifié\"\n}"
            },
            "url": "{{base_url}}/api/v1/professional/services/{{service_id}}"
          }
        },
        {
          "name": "Publier service",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/professional/services/{{service_id}}/publish"
          }
        },
        {
          "name": "Dépublier service",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/professional/services/{{service_id}}/unpublish"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  }
}